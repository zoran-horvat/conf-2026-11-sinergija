@page "/architecture"

<PageTitle>Mercury Outpost · Architecture</PageTitle>

<h1>Architecture</h1>
<div class="intro">
    <p>
        A robot is an agent, and so is the human at the outpost. Its tools and sensors are functions over the world.
        Its brain is an <code>IChatClient</code>, and the chat client it receives forwards to whichever of the two language models is selected in the top row.
        Dependencies run one way: from the agent to its functions and its brain, and from the functions to the world. Nothing depends on the agent.
    </p>
</div>

<figure class="diagram">
    <svg class="uml" viewBox="0 0 1100 650" aria-hidden="true">
        <defs>
            <marker id="gen" markerWidth="14" markerHeight="14" refX="13" refY="7" orient="auto" markerUnits="userSpaceOnUse">
                <path class="marker-hollow" d="M1,1 L13,7 L1,13 z" />
            </marker>
            <marker id="dep" markerWidth="14" markerHeight="14" refX="12" refY="7" orient="auto" markerUnits="userSpaceOnUse">
                <path class="marker-open" d="M1,1 L12,7 L1,13" />
            </marker>
            <marker id="comp" markerWidth="18" markerHeight="12" refX="1" refY="6" orient="auto" markerUnits="userSpaceOnUse">
                <path class="marker-filled" d="M1,6 L9,1 L17,6 L9,11 z" />
            </marker>
        </defs>

        <!-- The three abstractions, on one line at the top -->
        <rect class="box abstraction" x="50" y="16" width="230" height="80" />
        <text class="stereo" x="165" y="34">«abstract»  Microsoft.Extensions.AI</text>
        <text class="name abstract highlight" x="165" y="57">AIFunction</text>
        <line class="sep" x1="50" y1="67" x2="280" y2="67" />
        <text class="member" x="62" y="87">InvokeAsync(arguments)</text>

        <rect class="box abstraction" x="400" y="16" width="200" height="58" />
        <text class="stereo" x="500" y="34">«abstract»  Microsoft.Agents.AI</text>
        <text class="name abstract highlight" x="500" y="57">AIAgent</text>

        <rect class="box abstraction" x="785" y="16" width="250" height="80" />
        <text class="stereo" x="910" y="34">«interface»  Microsoft.Extensions.AI</text>
        <text class="name highlight" x="910" y="57">IChatClient</text>
        <line class="sep" x1="785" y1="67" x2="1035" y2="67" />
        <text class="member" x="797" y="87">GetResponseAsync(messages)</text>

        <!-- Everything below the abstractions sits 40 units lower; connectors reach up to them -->
        <g transform="translate(0 40)">
        <!-- Robot : ChatClientAgent -->
        <rect class="box" x="370" y="130" width="260" height="160" />
        <text class="stereo" x="500" y="148">«ChatClientAgent»</text>
        <text class="name" x="500" y="171">Robot</text>
        <line class="sep" x1="370" y1="181" x2="630" y2="181" />
        <text class="member" x="382" y="202">instructions : string</text>
        <text class="member" x="382" y="222">tools : AITool [1..*]</text>
        <text class="member" x="382" y="242">session : AgentSession</text>
        <line class="sep" x1="370" y1="253" x2="630" y2="253" />
        <text class="member" x="382" y="275">RunAsync(order : string)</text>

        <!-- Human : ChatClientAgent, below and to the right -->
        <rect class="box" x="430" y="330" width="260" height="160" />
        <text class="stereo" x="560" y="348">«ChatClientAgent»</text>
        <text class="name" x="560" y="371">Human</text>
        <line class="sep" x1="430" y1="381" x2="690" y2="381" />
        <text class="member" x="442" y="402">instructions : string</text>
        <text class="member" x="442" y="422">tools : AITool [1..*]</text>
        <text class="member" x="442" y="442">session : AgentSession</text>
        <line class="sep" x1="430" y1="453" x2="690" y2="453" />
        <text class="member" x="442" y="475">RunAsync(order : string)</text>

        <!-- Generalizations: a shared tree into AIAgent; the Human's branch hops the Robot's brain line -->
        <line class="line" x1="500" y1="130" x2="500" y2="100" />
        <path class="line" d="M660,330 V213 A8,8 0 0 1 660,197 V100 H500 V34" marker-end="url(#gen)" />

        <!-- Operator chat box -->
        <rect class="box" x="460" y="530" width="200" height="58" />
        <text class="stereo" x="560" y="548">«boundary»  UI</text>
        <text class="name small" x="560" y="570">Chat box</text>
        <line class="line dashed" x1="560" y1="530" x2="560" y2="490" marker-end="url(#dep)" />
        <text class="label" x="568" y="515">orders</text>

        <!-- Robot ◆— tools -->
        <path class="line" d="M370,160 H354 V16 H280" marker-start="url(#comp)" />
        <text class="label mid" x="330" y="10">tools</text>
        <text class="label" x="286" y="10">1..*</text>

        <!-- Human ◆— tools -->
        <path class="line" d="M430,400 H340 V38 H280" marker-start="url(#comp)" />
        <text class="label mid" x="385" y="394">tools</text>
        <text class="label" x="286" y="54">1..*</text>

        <!-- Concrete functions -->
        <line class="line" x1="165" y1="130" x2="165" y2="56" marker-end="url(#gen)" />
        <line class="line" x1="46" y1="130" x2="292" y2="130" />
        <line class="line" x1="46" y1="130" x2="46" y2="150" />
        <line class="line" x1="128" y1="130" x2="128" y2="150" />
        <line class="line" x1="210" y1="130" x2="210" y2="150" />
        <line class="line" x1="292" y1="130" x2="292" y2="150" />

        <rect class="box" x="10" y="150" width="72" height="48" />
        <text class="name small" x="46" y="179">Move</text>
        <rect class="box" x="92" y="150" width="72" height="48" />
        <text class="name small" x="128" y="179">PickUp</text>
        <rect class="box" x="174" y="150" width="72" height="48" />
        <text class="name small" x="210" y="179">Scan</text>
        <rect class="box" x="256" y="150" width="72" height="48" />
        <text class="name small" x="292" y="179">Status</text>

        <line class="sep" x1="10" y1="210" x2="164" y2="210" />
        <text class="label mid" x="87" y="226">tools: change the world</text>
        <line class="sep" x1="174" y1="210" x2="328" y2="210" />
        <text class="label mid" x="251" y="226">sensors: read the world</text>

        <!-- World -->
        <rect class="box" x="70" y="270" width="200" height="120" />
        <text class="stereo" x="170" y="288">«deterministic»</text>
        <text class="name" x="170" y="311">World</text>
        <line class="sep" x1="70" y1="321" x2="270" y2="321" />
        <text class="member" x="82" y="341">robots : Robot [*]</text>
        <text class="member" x="82" y="361">humans : Human [*]</text>
        <text class="member" x="82" y="381">other objects</text>

        <line class="line dashed" x1="87" y1="234" x2="130" y2="270" marker-end="url(#dep)" />
        <text class="label end" x="96" y="260">«writes»</text>
        <line class="line dashed" x1="251" y1="234" x2="215" y2="270" marker-end="url(#dep)" />
        <text class="label" x="246" y="260">«reads»</text>

        <!-- brain associations -->
        <path class="line" d="M630,205 H700 V16 H785" marker-end="url(#dep)" />
        <text class="label" x="708" y="150">brain</text>
        <text class="label end" x="779" y="10">1</text>

        <path class="line" d="M680,330 V222 H720 V38 H785" marker-end="url(#dep)" />
        <text class="label" x="728" y="200">brain</text>
        <text class="label end" x="779" y="54">1</text>

        <!-- SelectedChatClient -->
        <rect class="box" x="785" y="150" width="250" height="78" />
        <text class="name" x="910" y="172">SelectedChatClient</text>
        <line class="sep" x1="785" y1="182" x2="1035" y2="182" />
        <text class="member" x="797" y="202">selection : ModelSelection</text>
        <text class="member" x="797" y="220">forwards to the selected pipeline</text>

        <line class="line dashed" x1="910" y1="150" x2="910" y2="56" marker-end="url(#gen)" />

        <!-- Pipelines -->
        <rect class="box" x="720" y="280" width="175" height="100" />
        <text class="stereo" x="807" y="298">«IChatClient»</text>
        <text class="name small" x="807" y="318">Anthropic pipeline</text>
        <line class="sep" x1="720" y1="326" x2="895" y2="326" />
        <text class="member small" x="730" y="343">AnthropicClient</text>
        <text class="member small" x="730" y="359">UseFunctionInvocation</text>
        <text class="member small" x="730" y="375">UseOpenTelemetry</text>

        <rect class="box" x="915" y="280" width="175" height="100" />
        <text class="stereo" x="1002" y="298">«IChatClient»</text>
        <text class="name small" x="1002" y="318">Ollama pipeline</text>
        <line class="sep" x1="915" y1="326" x2="1090" y2="326" />
        <text class="member small" x="925" y="343">OllamaApiClient</text>
        <text class="member small" x="925" y="359">UseFunctionInvocation</text>
        <text class="member small" x="925" y="375">UseOpenTelemetry</text>

        <line class="line dashed" x1="860" y1="228" x2="807" y2="280" marker-end="url(#dep)" />
        <line class="line dashed" x1="960" y1="228" x2="1002" y2="280" marker-end="url(#dep)" />
        <line class="line dashed thin" x1="833" y1="254" x2="981" y2="254" />
        <text class="label mid" x="907" y="249">{xor}</text>

        <!-- Language models -->
        <rect class="box external" x="720" y="430" width="175" height="70" />
        <text class="stereo" x="807" y="448">«external»  LLM</text>
        <text class="name" x="807" y="471">Claude</text>
        <text class="member small mid" x="807" y="491">Anthropic API · https</text>

        <rect class="box external" x="915" y="430" width="175" height="70" />
        <text class="stereo" x="1002" y="448">«external»  LLM</text>
        <text class="name" x="1002" y="471">llama3.2</text>
        <text class="member small mid" x="1002" y="491">Ollama · localhost:11434</text>

        <line class="line dashed" x1="807" y1="380" x2="807" y2="430" marker-end="url(#dep)" />
        <line class="line dashed" x1="1002" y1="380" x2="1002" y2="430" marker-end="url(#dep)" />
        </g>
    </svg>
    <figcaption class="legend">
        <span><i class="key key-gen"></i> generalization</span>
        <span><i class="key key-real"></i> realization</span>
        <span><i class="key key-dep"></i> dependency</span>
        <span><i class="key key-comp"></i> composition</span>
    </figcaption>
</figure>
